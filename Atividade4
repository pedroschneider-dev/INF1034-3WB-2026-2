from turtle import *
from math import sqrt
t = Turtle()
t.speed(0)
def draw_plano_cartesiano2():
    t.pu()
    t.goto(-300, 0)
    t.pd()
    t.goto(300, 0)
    t.pu()
    t.goto(0, -300)
    t.pd()
    t.goto(0, 300)
def raiz_quadrada():
    draw_plano_cartesiano2()
    escala = 30
    t.pu()
    x = 0
    y = sqrt(x)
    t.goto(x * escala, y * escala)
    t.pd()
    while x <= 10:
        y = sqrt(x)
        t.goto(x * escala, y * escala)
        x += 0.05
raiz_quadrada()
clear()

