from turtle import *
t = Turtle()
#PLANOCARTESIANO 
def draw_plano_cartesiano():
    t.pu()
    t.color("black")
    t.goto(-400, 0) # eixo X
    t.pd()
    t.goto(400, 0)
    t.stamp()
    t.pu()
    t.goto(0, -400) # eixo Y
    t.pd()
    t.setheading(90)
    t.goto(0, 300)
    t.stamp()
    t.pu()
    t.color("black")

draw_plano_cartesiano()

clear()
